{
  "id": "ui.saved_view.set",
  "version": "1",
  "risk_level": "L0",
  "permission": "ui.saved_view.manage",
  "principal_types": ["HUMAN"],
  "environments": ["development", "staging", "production"],
  "idempotency": "UPSERT_BY_OWNER_ENVIRONMENT_TABLE_NAME",
  "write_confirmation": "ACTION_RESULT_AND_QUERY_REFETCH",
  "approval": {"required": false},
  "compensation_mode": "MANUAL",
  "params": {
    "table_key": {"type": "string", "required": true},
    "name": {"type": "string", "required": true},
    "schema_version": {"type": "int", "required": true},
    "query": {"type": "string", "required": false},
    "filters_json": {"type": "string", "required": true},
    "sort_column": {"type": "string", "required": false},
    "sort_direction": {"type": "string", "required": false, "enum": ["", "asc", "desc"]},
    "known_columns": {"type": "string_slice", "required": true},
    "visible_columns": {"type": "string_slice", "required": true},
    "density": {"type": "string", "required": true, "enum": ["compact", "standard", "comfortable"]}
  },
  "notes": "XM-B003 personal SavedView. owner issuer/subject/identity zone and Environment are derived only from the authenticated HUMAN Principal. Audit before/after summaries contain only canonical state_hash; query, filters, name, and columns never enter audit or logs."
}

