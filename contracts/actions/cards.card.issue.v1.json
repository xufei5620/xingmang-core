{
  "id": "cards.card.issue",
  "version": "1",
  "risk_level": "L2",
  "permission": "card.issue",
  "principal_types": [
    "HUMAN"
  ],
  "environments": [
    "development",
    "staging",
    "production"
  ],
  "idempotency": "REQUIRED_CLIENT_KEY",
  "write_confirmation": "ACTION_RESULT_AND_QUERY_REFETCH",
  "approval": {
    "required": false
  },
  "compensation_mode": "NOT_POSSIBLE",
  "params": {
    "idempotency_key": {
      "type": "string",
      "required": true
    },
    "product_id": {
      "type": "int",
      "required": true
    },
    "top_up_amount": {
      "type": "string",
      "required": true
    },
    "token_type": {
      "type": "string",
      "required": true,
      "enum": [
        "USDT",
        "USDC"
      ]
    },
    "user_email": {
      "type": "string",
      "required": true
    },
    "holder_name": {
      "type": "string",
      "required": true
    },
    "owner_ref": {
      "type": "string",
      "required": false
    }
  },
  "notes": "XM-CARD1 开卡。风险等级 L2 而非 L1：开卡真的把钱花出去，高于「修改低风险平台配置」；不升 L3 是因为产品负责人明确选择不设人工审批，而宪法条款 9 规定 L3/L4 必须审批。改这一级等于改审批策略。idempotency 是 REQUIRED_CLIENT_KEY 而不是 REQUIRED_FOUNDATION_B：上游 /v2/cards/apply 没有幂等键，去重完全由平台承担——幂等键派生出 card_alias 写给上游，超时后靠 ListCards(alias) 精确匹配对账。compensation_mode 是 NOT_POSSIBLE：卡一旦开出来就无法「撤销开卡」，只能赎回余额并冻结，那是另外两个 Action。金额上限见 internal/platform/cards/limits.go，上限未配齐时 fail closed。"
}
