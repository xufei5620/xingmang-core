# In-memory UI demonstration for `npm run dev` only, no backend required.
# Production builds deliberately reject mock mode and default to HTTP.
VITE_API_MODE=mock

# To use the local Go API instead:
# VITE_API_MODE=http
# VITE_API_BASE_URL=
#
# Vite proxies /api and /healthz to http://127.0.0.1:8088 during development.
# X-Mock-User-ID/X-Mock-Role are injected only by development builds.
