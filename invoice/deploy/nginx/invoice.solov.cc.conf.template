# Future host template only; not applied by this task. Keep user SPA base=/.
server {
    listen 80;
    server_name invoice.solov.cc;
    access_log off;
    return 301 https://invoice.solov.cc$uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name invoice.solov.cc;
    ssl_certificate /www/server/panel/vhost/cert/invoice.solov.cc/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/invoice.solov.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location /internal/ { return 404; }
    location = /metrics { return 404; }
    location /embed/ { return 410; }
    location /admin { return 410; }
    location / {
        proxy_pass http://127.0.0.1:58090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 24m;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
    }
}
