server {
    listen 80;
    listen [::]:80;
    server_name auth.solov.cc;
    access_log off;
    # Never carry authorization-code or state query values across plaintext.
    return 301 https://auth.solov.cc$uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.solov.cc;
    server_tokens off;

    ssl_certificate     /www/server/panel/vhost/cert/auth.solov.cc/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/auth.solov.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SOLOV_AUTH_TLS:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Authorization requests and callbacks contain state/code query values.
    # Keycloak event/audit logging remains enabled; raw edge URLs are not kept.
    access_log off;
    error_log /www/wwwlogs/auth.solov.cc.error.log warn;

    client_max_body_size 2m;

    # hostname-admin changes generated URLs but does not prevent the Admin REST
    # API from answering on the frontend listener. Enforce that boundary here.
    location = /admin { return 404; }
    location ^~ /admin/ { return 404; }

    # The master realm authenticates Keycloak operators. Its endpoints are
    # required by the Admin Console but must share the exact admin/break-glass
    # source policy even when Keycloak generates the public frontend hostname.
    location = /realms/master {
        include /www/server/panel/vhost/nginx/access/auth-admin.solov.cc.allow.conf;
        proxy_pass http://127.0.0.1:58180;
        include /www/server/panel/vhost/nginx/proxy/keycloak-proxy-headers.conf;
    }
    location ^~ /realms/master/ {
        include /www/server/panel/vhost/nginx/access/auth-admin.solov.cc.allow.conf;
        proxy_pass http://127.0.0.1:58180;
        include /www/server/panel/vhost/nginx/proxy/keycloak-proxy-headers.conf;
    }

    # Expose only Keycloak's documented public reverse-proxy paths.
    location ^~ /realms/ {
        proxy_pass http://127.0.0.1:58180;
        include /www/server/panel/vhost/nginx/proxy/keycloak-proxy-headers.conf;
    }
    location ^~ /resources/ {
        proxy_pass http://127.0.0.1:58180;
        include /www/server/panel/vhost/nginx/proxy/keycloak-proxy-headers.conf;
    }
    location ^~ /.well-known/ {
        proxy_pass http://127.0.0.1:58180;
        include /www/server/panel/vhost/nginx/proxy/keycloak-proxy-headers.conf;
    }

    location / { return 404; }
}
