server {
    listen 80;
    listen [::]:80;
    server_name auth-admin.solov.cc;
    access_log off;
    # Administration is HTTPS-only; do not even redirect an untrusted source.
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth-admin.solov.cc;
    server_tokens off;

    ssl_certificate     /www/server/panel/vhost/cert/auth-admin.solov.cc/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/auth-admin.solov.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SOLOV_AUTH_ADMIN_TLS:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    access_log off;
    error_log /www/wwwlogs/auth-admin.solov.cc.error.log warn;
    client_max_body_size 2m;

    # This root-owned include must contain only exact /32 or /128 allow entries
    # followed by deny all. Missing it makes nginx -t fail closed.
    include /www/server/panel/vhost/nginx/access/auth-admin.solov.cc.allow.conf;

    location / {
        proxy_pass http://127.0.0.1:58181;
        include /www/server/panel/vhost/nginx/proxy/keycloak-proxy-headers.conf;
    }
}
