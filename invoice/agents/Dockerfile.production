ARG GO_IMAGE=golang:1.25.13-alpine@sha256:1e0126852075c9c60731c8ba49088448b91f63e2aed97ca9d1a9791622a05946
ARG ALPINE_IMAGE=alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY sourceagent ./sourceagent
ARG SOURCE_AGENT_VERSION=0.3.0
RUN CGO_ENABLED=0 GOOS=linux go build -mod=readonly -trimpath \
    -ldflags="-s -w -X main.buildVersion=${SOURCE_AGENT_VERSION}" \
    -o /out/source-agent-prod ./cmd/source-agent-prod \
    && CGO_ENABLED=0 GOOS=linux go build -mod=readonly -trimpath \
    -ldflags="-s -w" -o /out/source-keygen ./cmd/source-keygen

FROM ${ALPINE_IMAGE} AS certificates
RUN apk add --no-cache ca-certificates

FROM scratch AS keygen
COPY --from=build /out/source-keygen /source-keygen
USER 65532:65532
ENTRYPOINT ["/source-keygen"]

# Keep this as the final/default target. The production runtime contains no
# shell and no key-generation utility.
FROM scratch AS production
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/source-agent-prod /source-agent-prod
USER 65532:65532
ENTRYPOINT ["/source-agent-prod"]
CMD ["run"]
