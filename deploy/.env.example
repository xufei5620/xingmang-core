# Local development only. Do not place production credentials in this file.
APP_ENV=development
SOURCE_MODE=mock
AUTH_MODE=mock
SOURCE_INGESTION_ENABLED=false

# Local service bindings. All published ports are loopback-only in Compose.
POSTGRES_DB=invoice_dev
POSTGRES_USER=invoice_dev
POSTGRES_PASSWORD=invoice_dev_only
POSTGRES_PORT=55432
REDIS_PORT=56379
INVOICE_API_PORT=58088
INVOICE_WEB_PORT=58090
MAILPIT_SMTP_PORT=58025
MAILPIT_UI_PORT=58080
MOCK_SOURCE_PORT=58081

DATABASE_URL=postgres://invoice_dev:invoice_dev_only@postgres:5432/invoice_dev?sslmode=disable
REDIS_URL=redis://redis:6379/0
MOCK_SOURCE_BASE_URL=http://mock-source:8080

# Mock/local authentication. Production must use OIDC and must reject mock mode.
OIDC_ISSUER_URL=https://auth.mock.invalid/realms/invoice
OIDC_WEB_CLIENT_ID=invoice-web-mock
OIDC_WEB_CLIENT_SECRET_FILE=
OIDC_ADMIN_CLIENT_ID=invoice-admin-mock
OIDC_ADMIN_CLIENT_SECRET_FILE=
OIDC_DESKTOP_CLIENT_ID=invoice-desktop-mock
OIDC_REQUIRED_ADMIN_ACR=urn:invoice:mfa
OIDC_ISSUER_PUBLIC_DISPLAY=false

# Mailpit notification delivery. This file represents the current mock/local
# milestone. Production first uses SMTP_PASSWORD_FILE as deployment-locked;
# settings-backed rotation is enabled only after a KMS/secret backend exists.
# The only QQ transport implemented in the current code is smtp.qq.com:587 with
# required STARTTLS. It is not production-approved until integration gates pass.
# Port 465 implicit TLS is not implemented yet.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS_REQUIRED=false
SMTP_USERNAME=
SMTP_PASSWORD_FILE=
SMTP_FROM_ADDRESS=invoice-dev@example.invalid
SMTP_FROM_NAME=Invoice Development
SMTP_SECRET_WRITE_ONLY=true
SMTP_TEST_RECIPIENT_MODE=current_admin_verified_only

# Embedded user surface and administrator defense in depth.
EMBED_ALLOWED_PARENT_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=__Host-invoice_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=Lax
BOOTSTRAP_QUERY_LOGGING=false
# Development/mock-only bootstrap convenience. Production must reject/ignore it.
ADMIN_BOOTSTRAP_IP_ALLOWLIST=127.0.0.1/32,::1/128
# Planned deployment-only recovery policy. Production supplies a root-managed
# file. Raw CIDRs never enter memory/DB settings or any settings API. The current
# mock milestone does not yet enforce this file.
ADMIN_BREAK_GLASS_CIDRS_FILE=
# Keep false until durable settings, real MFA, two-phase activation and replica
# propagation/rollback have been implemented and tested.
ADMIN_DYNAMIC_CIDR_UPDATES_ENABLED=false
ADMIN_DYNAMIC_CIDR_MAX_ENTRIES=16
ADMIN_DYNAMIC_CIDR_MIN_PREFIX_V4=24
ADMIN_DYNAMIC_CIDR_MIN_PREFIX_V6=64
ADMIN_CIDR_CACHE_MAX_STALE_SECONDS=60
TRUSTED_PROXY_CIDRS=
TRUSTED_CLIENT_IP_HEADERS=

# Current self-service store is memory-only and non-production. Immutable
# durable history below is a production target, not an implemented guarantee.
SETTINGS_SELF_SERVICE_ENABLED=true
HISTORY_SNAPSHOT_IMMUTABLE=true
ISSUER_LEGAL_IDENTIFIERS_MASKED_BY_DEFAULT=true

# File security defaults.
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_ALLOWED_TYPES=application/pdf
DOCUMENT_DOWNLOAD_TTL_SECONDS=60
DOCUMENT_STORAGE_PUBLIC=false
MALWARE_SCAN_REQUIRED=true
CLAMAV_ADDRESS=clamav:3310

# Production source-agent variables are intentionally empty in the mock file.
SOURCE_ID=sub2api-mock
SOURCE_DB_DSN_FILE=
INGESTION_URL=
SOURCE_MTLS_CERT_FILE=
SOURCE_MTLS_KEY_FILE=
SOURCE_MTLS_CA_FILE=
SOURCE_SIGNING_KEY_FILE=
SOURCE_SIGNING_KEY_ID=
SUB2API_INTERNAL_ORIGIN=
SUB2API_ADMIN_KEY_FILE=
