# Required: copy the exact image tag from the newly verified release manifest.
# API, tools, PDF scanner and web are intentionally locked to this one value.
INVOICE_IMAGE_TAG=REPLACE_WITH_EXACT_REVIEWED_RELEASE_TAG
INVOICE_API_PORT=58088
INVOICE_WEB_PORT=58090
ELIGIBILITY_START_AT=2026-09-01T00:00:00+08:00
INVOICE_INGEST_NETWORK=invoice-system-ingest
INVOICE_EDGE_SUBNET=172.30.239.0/28
INVOICE_DB_SUBNET=172.30.240.0/28
INVOICE_APP_SUBNET=172.30.241.0/28
CLAMAV_EGRESS_SUBNET=172.30.242.0/28
OIDC_PREFLIGHT_EGRESS_SUBNET=172.30.243.0/28
INVOICE_PROXY_SUBNET=172.30.250.0/28
INVOICE_PROXY_GATEWAY_IP=172.30.250.1
INVOICE_INGEST_SUBNET=172.30.251.0/27
INVOICE_INGEST_DYNAMIC_RANGE=172.30.251.0/28
INVOICE_INGEST_PROXY_IP=172.30.251.30
INVOICE_INGEST_PROXY_CIDR=172.30.251.30/32
SECRETS_DIR=/root/invoice-system/secrets
ADMIN_SETTINGS_BOOTSTRAP_FILE=/root/invoice-system/config/admin-settings.bootstrap.json
SOURCE_TRUST_CONFIG_FILE=/root/invoice-system/config/source-trust.json
SOURCE_INSTANCES_CONFIG_FILE=/root/invoice-system/config/source-instances.json

# Keycloak listens on the same private container port, published twice on
# loopback so the host Nginx can enforce independent public/admin path policy.
# The trusted address must equal the exact keycloak_edge gateway plus /32.
KEYCLOAK_HTTP_PORT=58180
KEYCLOAK_ADMIN_HTTP_PORT=58181
KEYCLOAK_DB_SUBNET=172.30.244.0/28
KEYCLOAK_EDGE_SUBNET=172.30.254.0/29
KEYCLOAK_EDGE_GATEWAY=172.30.254.1
KC_PROXY_TRUSTED_ADDRESSES=172.30.254.1/32

# Set this to the exact configured invoice_proxy gateway plus /32. The API
# rejects bridge subnets, multiple proxy entries and every wider prefix.
TRUSTED_PROXY_CIDRS=172.30.250.1/32

OIDC_ISSUER_URL=https://auth.solov.cc/realms/solov
OIDC_CLIENT_ID=invoice-web
OIDC_PROVIDER_LABEL=SoloV 统一登录
OIDC_ADMIN_ROLE=invoice-admin
OIDC_ROLE_CLAIM=roles
OIDC_REQUIRED_ADMIN_ACR=urn:solov:loa:2
OIDC_REQUIRED_ADMIN_AMR=otp
OIDC_ALLOWED_SIGNING_ALGS=RS256
OIDC_ALLOWED_ENDPOINT_HOSTS=auth.solov.cc
# Leave empty for a public IdP. Private IdPs require exact canonical RFC1918
# or ULA addresses; loopback, link-local and metadata ranges are never allowed.
OIDC_ALLOWED_PRIVATE_ENDPOINT_IPS=
OIDC_LOGOUT_TOKEN_MAX_AGE=10m
OIDC_MAX_HTTP_RESPONSE_BYTES=1048576
OIDC_PREFLIGHT_TIMEOUT=30s

# Startup/uploads fail closed if main/daily signatures are missing or the
# actual daily.* database file is older than this duration, even when clamd
# still responds to PING. freshclam.dat mtime is not a freshness signal.
CLAMAV_MAX_SIGNATURE_AGE=48h

# Binary protocol/build version is independent from the common release image
# tag above. The source-agent image itself also uses INVOICE_IMAGE_TAG.
SOURCE_AGENT_VERSION=0.3.0
SOURCE_STATE_ROOT=/root/invoice-system/source-state
SOURCE_CUTOVER_ROOT=/root/invoice-system/source-state/cutover
SUB2API_SOURCE_ID=10000000-0000-4000-8000-000000000001
NEWAPI_SOURCE_ID=10000000-0000-4000-8000-000000000002
SUB2API_RUNTIME_VERSION=0.1.179
NEWAPI_RUNTIME_VERSION=v1.0.0-rc.25
SUB2API_PROJECTION_NETWORK=invoice-sub2api-projection
SUB2API_PROJECTION_SUBNET=172.30.252.0/28
NEWAPI_PROJECTION_NETWORK=invoice-newapi-projection
NEWAPI_PROJECTION_SUBNET=172.30.253.0/28
SUB2API_OIDC_PROVIDER_KEY=REPLACE_AFTER_OIDC_CONFIGURATION
NEWAPI_OAUTH_PROVIDER_SLUG=solov-sso
SUB2API_PAYMENTS_SIGNING_KEY_ID=2026-08-payments
SUB2API_IDENTITIES_SIGNING_KEY_ID=2026-08-identities
SUB2API_USAGE_SIGNING_KEY_ID=2026-08-usage
SUB2API_CREDITS_SIGNING_KEY_ID=2026-08-credits
SUB2API_BALANCES_SIGNING_KEY_ID=2026-08-balances
NEWAPI_PAYMENTS_SIGNING_KEY_ID=2026-08-payments
NEWAPI_IDENTITIES_SIGNING_KEY_ID=2026-08-identities
NEWAPI_USAGE_SIGNING_KEY_ID=2026-08-usage
NEWAPI_CREDITS_SIGNING_KEY_ID=2026-08-credits
NEWAPI_BALANCES_SIGNING_KEY_ID=2026-08-balances
# The API fails readiness, user submission and final manual issue confirmation
# when a required signed source stream is older than its threshold.
SOURCE_PAYMENTS_MAX_STALENESS=5m
SOURCE_IDENTITIES_MAX_STALENESS=15m
SOURCE_USAGE_MAX_STALENESS=5m
SOURCE_CREDITS_MAX_STALENESS=15m
SOURCE_BALANCES_MAX_STALENESS=15m
