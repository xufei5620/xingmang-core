# deploy/compose/launch.yaml 的环境变量样例（XM-0023）。
#
# 用法：
#   cp deploy/compose/.env.example deploy/compose/.env
#   然后把 DATABASE_PASSWORD 换成真实值。
#
# ⚠️ 真实的 .env **不入库**：根 .gitignore 里的 `.env` / `.env.*` 已经挡住，
#    `!*.example` 才让本文件通过。提交前用 `git status` 确认 .env 没被列出来。
#    仓库里出现明文凭据 = 宪法 7 条事故，撤销比防住贵得多。

# ---------------------------------------------------------------------------
# 环境
# ---------------------------------------------------------------------------
# development / staging / production 三选一。
# ⚠️ 改成 production 会让 platform-api **拒绝启动**，除非同时把身份切到 OIDC
#    （见下面「身份」一节）：Foundation-A 的身份来自 X-Dev-* 请求头，允许调用方
#    自称身份等于没有鉴权。上生产的前置条件是 CR-0001（Keycloak/OIDC）。
ENVIRONMENT=staging

# ---------------------------------------------------------------------------
# 身份（XM-0008 / XM-LOGIN）
# ---------------------------------------------------------------------------
# XM_AUTH_MODE ∈ dev-header | oidc | local。默认跟着 ENVIRONMENT 走：
#   production → oidc（development / staging → dev-header）；
#   local 在任何环境都允许显式选用——它不是 dev-header 那种「请求头自称
#   身份」，账号与口令哈希都在平台自己的库里（core.staff_account），
#   有真实的鉴权语义。server-prod.yaml 已把生产默认改成 local；
#   本文件（launch.yaml 的 staging 一键栈）仍走下面注释掉的 oidc 或
#   干脆留空回落到 dev-header，按需选一种打开。
#
# ⚠️ 下面三行**刻意注释掉**：CR-0001 还没执行，没有 solov-staff Realm 可连。
#    打开它们之前请先读 docs/modules/httpapi/AUTH-SWITCH.md，特别是
#    「RoleScopeMap 必须人工审定」那一节——它决定登录进来的员工默认能看到什么。
#
# XM_AUTH_MODE=oidc
# XM_OIDC_ISSUER=https://auth.solov.cc/realms/solov-staff
# XM_OIDC_AUDIENCE=xingmang-admin-web
#
# 可选：
# XM_OIDC_ROLE_SCOPES={"staff":["registry.read","ops.read","ui.saved_view.manage"]}   # 留空用代码默认表；显式值部署时需同步个人视图 scope
# XM_OIDC_JWKS_URL=...   # 留空从 issuer 的 /.well-known 发现；必须与 issuer 同源
# XM_OIDC_CLOCK_SKEW=60s # 时钟偏移容忍，上限 5m
#
# --- local 模式（XM-LOGIN）---------------------------------------------------
# 打开它只需要一行：
# XM_AUTH_MODE=local
# XM_OIDC_ROLE_SCOPES 同样对 local 生效——两种模式共用同一张「角色 -> scope」
# 翻译表（留空用 oidcauth.DefaultRoleScopeMap，admin 角色默认含
# staff.manage/credential.manage/connector.manage）。
#
# 管理员来源 IP 名单（XM-AUTH-TOTP0/CR-0006 c 条）：逗号分隔 CIDR，留空=不启用，
# 只对持有 staff.manage/finance.read 一类角色（TOTP 强制范围内）的账号生效，
# 是纵深防御，不是唯一防线。见 docs/modules/httpapi/AUTH-SWITCH.md §11.7。
# XM_CONSOLE_ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.4/32
#
# --- 开票管理员断言签发（CR-0006/XM-INVCON1）------------------------------
# 默认关闭：本仓库只装配签发能力，不激活。前置条件 XM_AUTH_MODE=local
# （依赖本地登录会话的 TOTP 新鲜度 mfa_at）。启用步骤：
#   1) 用 cmd/console-assertion-keygen 生成一把 Ed25519 密钥；
#   2) 把打印出的私钥值经 credential.secret.upsert Action 存到下面
#      KEY_REF 指向的引用（工具本身不碰密钥库，只打印，见工具自带说明）；
#   3) 把工具同时打印出的公钥清单条目，提交进本仓库与开票仓库各自的
#      contracts/auth/console-assertion-keyring.v1.json（两边必须一致）；
#   4) 与开票侧核对 ISSUER/AUDIENCE 取值逐字相同——两侧各自配置，不自动同步。
# 详见 docs/handoffs/slices/XM-INVCON1.md「生产上线步骤」。
# XM_INVOICE_CONSOLE_ASSERTION_ENABLED=true
# XM_INVOICE_CONSOLE_ASSERTION_ISSUER=https://console.solov.cc   # 精确 https 来源，不带路径/查询/片段
# XM_INVOICE_CONSOLE_ASSERTION_AUDIENCE=xingmang-console-assertion-v1   # 留空用此默认值
# XM_INVOICE_CONSOLE_ASSERTION_KEY_REF=secret://console-assertion/signing-key-2026-09
# XM_INVOICE_CONSOLE_ASSERTION_STEP_UP_MAX_AGE=10m   # 留空用默认 10 分钟
#
# 冷启动时库里还没有任何本地账号，staff.account.create Action 又要求调用者
# 已经持有 staff.manage——第一个账号只能用下面这条 Platform Lifecycle
# Operation 建出来（tools profile，只运行一次）：
#   docker compose -p xingmang-launch -f deploy/compose/launch.yaml \
#     --profile tools run --rm staff-bootstrap
# 两个变量：
XM_STAFF_BOOTSTRAP_USERNAME=
# 留空会生成一个随机初始密码并打印到 stdout（唯一出现的地方，运行后请
# 立即转交本人并清理终端历史/CI 日志）；填了就用这个值（仍需满足
# 10..128 字符的口令策略）。
XM_STAFF_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
POSTGRES_DB=xingmang
POSTGRES_USER=xingmang

# 数据库密码。**必填**，没有默认值——compose 会直接报错退出，
# 而不是用一个「大家都知道」的弱口令把栈跑起来。
# 生成一个：openssl rand -base64 32
# 这个值同时用于：postgres 容器的初始化（走 Docker secret 文件）、
# 以及三个 Go 服务的 CredentialRef 解析（DATABASE_PASSWORD_REF → 本变量）。
DATABASE_PASSWORD=

# 密码的 CredentialRef（ADR-014）。格式 secret://<scope>/<name>。
# 服务不直接读固定环境变量名，而是解析这个 ref——将来换成 SOPS/Vault
# Provider 时，只有 Provider 的装配处要改，业务代码一行不动。
DATABASE_PASSWORD_REF=secret://database/postgres-password

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
# platform-api 单请求期限
REQUEST_TIMEOUT=30s

# --- /api/v1 限流（XM-R011）-------------------------------------------------
# 按 (Principal, 路由模板) 分桶的令牌桶。修的是「读端点可低成本反复拉取」：
# limit 是行数上限不是字节上限，而审计事件带操作前后镜像、指标历史带 jsonb 值。
#
# 默认 120/分钟 + 20 瞬时：人正常用不到，脚本一跑就撞上。
# **关不掉**——填 0 或负数会让 API 拒绝启动。要放宽就填一个更大的数字。
# 探针（/healthz、/readyz）天然豁免：它们不在 /api/v1 组里。
#
# ⚠️ 计数在**进程内存**里。多副本部署时每个副本各算各的，实际额度是副本数倍；
#    要跨副本一致需要共享计数器，那是另一件事。
XM_RATE_LIMIT_PER_MINUTE=120
XM_RATE_LIMIT_BURST=20

# worker 心跳间隔（River 要求 >= 1s）
HEARTBEAT_INTERVAL=1m

# Sub2API 连接器模式：fake / real（变量由 XM-0022 实现）。
# fake 的数据是**演示与联调**用的，不是业务真相——前端展示时必须能区分。
# 切 real 的完整步骤见 docs/modules/connector/RUNBOOK.md，下面四个变量是它的入参。
XM_SUB2API_MODE=fake

# --- 切真实数据用（XM_SUB2API_MODE=real 时四项缺一不可）-----------------------
# 四项没配齐时 worker **照常启动**，只是每轮同步往看板写一条
# not_supported 的失败观测，并在日志里说清缺哪个变量——一个没配好的采集
# 通道不该把心跳和别的任务一起拖垮。
#
# 上游只读端点，必须 https（http 会被连接配置直接拒绝）。
XM_SUB2API_ENDPOINT=
#
# 允许连接的主机**精确**清单，逗号分隔，不做后缀匹配、不做通配。
# 留空不是「放行一切」而是「一个请求都发不出去」（fail closed，ADR-004）。
# endpoint 的主机必须自己也在这份清单里，否则配置自相矛盾、一个请求都发不出。
# 例：XM_SUB2API_TARGET_ALLOWLIST=api.solov.cc
XM_SUB2API_TARGET_ALLOWLIST=
#
# 只读凭据的引用，形如 secret://<scope>/<name>（ADR-014、宪法 7 条）。
# 服务不直接读固定变量名，而是解析这个引用；将来换 SOPS/Vault 时
# 只有 cmd/platform-worker 里的登记表要改，Connector 一行不动。
# 例：XM_SUB2API_CREDENTIAL_REF=secret://sub2api/readonly-token
XM_SUB2API_CREDENTIAL_REF=
#
# 上面那个引用在 env Provider 下的落点：**只读**账号的 API Token 明文。
# ⚠️ 只填在不入库的 .env 里；轮换时改这里 + 上游吊销旧 token，不用改代码。
# ⚠️ 这个账号必须是只读的：平台侧只做了「不发写请求」的强制，
#    做不到「上游拒绝写请求」——后者只有发一个真正的只读账号才做得到。
XM_SUB2API_TOKEN=

# ---------------------------------------------------------------------------
# NewAPI 连接器（XM-0035，规格 §8.4）
# ---------------------------------------------------------------------------
# fake / real。fake 的数据是**演示与联调**用的，不是业务真相——
# 前端会按 XM_NEWAPI_INSTANCE_ID 的值挂出演示横幅把它标出来。
#
# 切 real 的完整步骤见 docs/runbooks/SWITCH-NEWAPI-REAL.md，
# 下面那组变量是它的入参。三项没配齐时配成 real 不会崩，只会每轮同步往看板
# 写一条 not_supported 的失败观测并说清缺哪个变量——「这条链路还没接通」是
# 一个事实，看板该看得见它，而不是让 NewAPI 那几格数据静静地不更新。
#
# ⚠️ 生产环境不接受 fake（演示数据不得成为运营读数）：要么配 real，
#    要么显式 XM_NEWAPI_SYNC_ENABLED=false。配错了 worker 会拒绝启动。
XM_NEWAPI_MODE=fake

# 采集链路的停用开关（宪法 26 条）。关掉之后看板不会假装新鲜：
# observed_at 不再前进，新鲜度自然降级（规格 §9.1）。
XM_NEWAPI_SYNC_ENABLED=true

# 同步周期。远小于这批指标 1800s 的新鲜度阈值：偶尔一两个周期失败不会立刻
# 把看板打成「延迟」，连续失败才会——这正是阈值该表达的意思。
XM_NEWAPI_SYNC_INTERVAL=300s

# 观测的 Source，会原样显示在看板的「来源」一栏。
# 默认带 -staging 后缀是有意的：Fake 产出的数字必须一眼能与真实来源区分开。
# 前端的演示横幅按这个值**整串相等**匹配（web 的 DEFAULT_DEMO_SOURCES），
# 改了这里要同步改前端，否则演示数据会失去「这是假的」这层标注。
XM_NEWAPI_INSTANCE_ID=newapi-staging

# --- 切真实数据用（XM_NEWAPI_MODE=real 时三项缺一不可，XM-0038）-------------
# 三项没配齐时 worker **照常启动**，只是每轮同步往看板写一条 not_supported
# 的失败观测，并在日志里说清缺哪个变量——一个没配好的采集通道不该把心跳和
# 别的任务一起拖垮。
#
# 上游只读端点，必须 https（http 会被连接配置直接拒绝）。
# 例：XM_NEWAPI_ENDPOINT=https://xm.solov.cc
XM_NEWAPI_ENDPOINT=
#
# 允许连接的主机**精确**清单，逗号分隔，不做后缀匹配、不做通配。
# 留空不是「放行一切」而是「一个请求都发不出去」（fail closed，ADR-004）。
# endpoint 的主机必须自己也在这份清单里，否则配置自相矛盾、一个请求都发不出。
# 例：XM_NEWAPI_TARGET_ALLOWLIST=xm.solov.cc
XM_NEWAPI_TARGET_ALLOWLIST=
#
# 凭据引用，形如 secret://<scope>/<name>（ADR-014、宪法 7 条）。
# 服务不直接读固定变量名，而是解析这个引用；将来换 SOPS/Vault 时
# 只有 cmd/platform-worker 里的登记表要改，Connector 一行不动。
# 例：XM_NEWAPI_CREDENTIAL_REF=secret://newapi/readonly-token
XM_NEWAPI_CREDENTIAL_REF=
#
# 上面那个引用在 env Provider 下的落点：NewAPI **管理员** access token 明文
# （上游后台「生成系统访问令牌」，对应 users.access_token）。
# ⚠️ 只填在不入库的 .env 里；轮换时改这里 + 上游重新生成，不用改代码。
# ⚠️ NewAPI **没有只读角色**——本包读的渠道/用户/日志/用量端点全挂 AdminAuth，
#    所以这把 token 在上游是全权限的。平台侧做了两件事来兜住这一点：
#    传输层只发 GET/HEAD、拒重定向、按 allowlist 锁主机（四道只读闸），
#    外加一份**写端点黑名单**——NewAPI 有一批 GET 方法却会写库的端点
#    （渠道测试、刷新余额、拉取模型，甚至会静默轮换调用者自己 token 的
#    /api/user/token），四道闸对它们全部放行，只能靠黑名单机械挡住。
# ⚠️ 千万别把这个 token 用在别处的自动化脚本里：任何一次
#    GET /api/user/token 都会把它作废。
XM_NEWAPI_TOKEN=
#
# 可选：旧版本 NewAPI 要求的 New-Api-User 头（管理员的用户 id）。
# 当前上游源码里这个头已经不参与鉴权，留空即可；
# 只有连老实例时上游返 401 才需要填上管理员的用户 id（一个整数，不是秘密）。
XM_NEWAPI_USER_ID=

# --- NewAPI 收入只读直查（XM-0044，设计稿 §3.2）------------------------------
# 利润台账的**收入侧**走只读 DSN，不是上面那条 HTTP 通道：上游的 HTTP 面答不出
# 「某个渠道今天赚了多少」（/api/log/self/stat 按令牌、/api/data/ 按模型+小时，
# 都没有渠道维度），而 quota_data 表里 channel_id 与 quota 都有，一条 SUM 就够。
#
# 没配这几项 = 台账里 newapi 账号的收入是 NULL（未知），**不是 0**。
# 把未知写成 0 会让毛利凭空等于成本的负数。
#
# 完整步骤 + 建只读角色的 SQL：docs/runbooks/SWITCH-NEWAPI-REAL.md
#
# 自营 new-api 库的连接串，**不含密码**。
# ⚠️ `?password=` 同样不行：pgx 会把 query 参数当连接设置读，并在填完 host/user
#    之后覆盖它们——`?password=` 与 `?host=` 都是真实的绕过口子（见
#    internal/platform/pgdsn）。平台会拒绝这条通道并在启动日志里说明原因。
# 例：XM_NEWAPI_REVENUE_DSN=postgres://xm_readonly@10.0.0.5:5432/newapi?sslmode=require
XM_NEWAPI_REVENUE_DSN=
#
# 口令引用，形如 secret://<scope>/<name>（ADR-014、宪法 7 条）。
# 例：XM_NEWAPI_REVENUE_PASSWORD_REF=secret://newapi/revenue-db
XM_NEWAPI_REVENUE_PASSWORD_REF=
#
# 上面那个引用在 env Provider 下的落点：只读库角色的口令明文。
# ⚠️ 建议单独建一个只读角色而不是复用 new-api 自己的库账号：
#    平台侧强制的是「不发写语句」（四道机械闸 + SELECT 白名单），
#    **做不到「服务端拒绝写」**——后者只有发一个真正的只读角色才做得到。
#    角色至少要能 SELECT 两张表：quota_data（收入来源）与 options（换算刻度）。
#    读不到 options 时平台会**拒绝取数**而不是猜一个刻度——猜错的倍数是
#    50 万量级，而算出来的数字看起来完全正常。
XM_NEWAPI_REVENUE_PASSWORD=

# ---------------------------------------------------------------------------
# 成本采集凭据（XM-REAL0-a）
# ---------------------------------------------------------------------------
# 登记簿里的每个账号/令牌都有自己的 CredentialRef；Worker 不预枚举，
# 考虑每次读取时按引用解析。provider 只接受 env 或 file，且必须给出
# 精确 scope 白名单；留空时 real 成本观测保持 not_supported，不影响心跳。
XM_FINANCE_COLLECT_SECRET_PROVIDER=
# file provider 使用容器内固定的只读根目录（<root>/<scope>/<name>）。
XM_FINANCE_COLLECT_SECRET_ROOT=/run/xm/finance-secrets
# 例：XM_FINANCE_COLLECT_SECRET_SCOPES=sub2api,newapi
XM_FINANCE_COLLECT_SECRET_SCOPES=
# env provider 的变量名约定：
#   secret://sub2api/token-a -> XM_FINANCE_SECRET_SUB2API__TOKEN_A
# 这些动态变量应通过受控部署环境注入，不要提交到仓库。

# ---------------------------------------------------------------------------
# 凭据登记（XM-CRED0）
# ---------------------------------------------------------------------------
# 运营在管理后台粘贴的上游凭据（credential.secret.upsert / rotate / revoke
# Action）以文件形式落在这个目录：<root>/<scope>/<name>。DB 只存引用、
# sha256 指纹前 16 位与版本，**没有值**。platform-api 是唯一的写方，
# platform-worker 以只读方式挂同一个卷（xm-secrets），经 FileProvider 按
# core.connector_config 里的引用读值。留空用默认值；两个服务必须填同一个路径。
XM_SECRET_ROOT=/run/xm/secrets
#
# 这两个动作与 connector.config.set（切 fake/real）的权限是
# credential.manage / connector.manage，**默认不在 staff/admin 里**——
# OIDC 模式下要在 XM_OIDC_ROLE_SCOPES 里给一个专门角色，例如
#   {"credential-admin":["credential.manage","connector.manage"]}
# dev-header 模式下把这两个 scope 写进 X-Dev-Scopes 即可。

# ---------------------------------------------------------------------------
# 成本看板运行参数（XM-0037b）
# ---------------------------------------------------------------------------
XM_FINANCE_COLLECT_MODE=fake
XM_FINANCE_COLLECT_ENABLED=true
XM_FINANCE_COLLECT_INTERVAL=300s
XM_FINANCE_COLLECT_INSTANCE_ID=finance-collect-staging
XM_FINANCE_COLLECT_TARGET_ALLOWLIST=
XM_FINANCE_COLLECT_REQUEST_TIMEOUT=10s

# ---------------------------------------------------------------------------
# 保留期清理（XM-R012）
# ---------------------------------------------------------------------------
# 指标样本以 5 分钟粒度追加（约 288 条/日/指标），十几条指标一年就是百万量级；
# 在这个任务之前没有任何清理路径。默认开着——一张没有清理路径的追加表迟早会
# 成为运维事故，默认关掉等于把这件事留给「以后有人想起来」。
#
# ⚠️ 审计事件不清理，一条都不删，所以这里**没有**审计保留天数这个变量。
#    审计链 append-only（宪法 11 条）；删掉中间任意一条都会断链，VerifyChain
#    会立刻报 sequence_gap；而且就算写了也删不掉——audit.audit_event 上的
#    audit_event_no_delete 规则（迁移 000003）让 DELETE 变成静默空操作。
#    完整理由见 internal/platform/jobs/retention.go 文件头。
#    审计的容量问题走**归档**（导出 + 链根锚定后转冷存储），另立任务。
XM_RETENTION_ENABLED=true
# 清理周期。保留期以天计，清理再频繁也只是把同样的行提前几小时删掉。
XM_RETENTION_INTERVAL=24h
# 指标样本保留天数。90 天覆盖季度回顾与影子对比的 14 天窗口；
# 更长跨度的趋势应当走降采样（日粒度汇总，尚未实现），而不是留着原始行。
XM_METRIC_SAMPLE_RETENTION_DAYS=90
# **已解决**告警的保留天数。未解决 / 已认领的告警**永远不删**，与天数无关——
# 一条至今没人处理的老告警恰恰是最不该被删的那种。
XM_ALERT_RETENTION_DAYS=180
# 两个天数都必须为正。填 0 会让 worker 拒绝启动：0 天 = 把整张表删空，
# 而想表达「不清理」的人该去关 XM_RETENTION_ENABLED。

# ---------------------------------------------------------------------------
# 连接器健康探测（XM-OPS0）
# ---------------------------------------------------------------------------
# 对当前生效的 sub2api / newapi 连接器周期性调用 Version() 与 Health()，
# 写观测供运行保障页「控制平面健康」子页展示。与 Sub2API/NewAPI 同步同一条
# 纪律：默认开着，关掉是显式停用（宪法 26 条）。
XM_CONNECTOR_PROBE_ENABLED=true
# 探测周期，默认 5 分钟。新鲜度阈值固定 900 秒（3 个周期），不随本变量联动。
XM_CONNECTOR_PROBE_INTERVAL=5m
# 生产环境下，若连接器生效模式仍是 fake，探测会被启动闸拦下（与
# XM_SUB2API_MODE / XM_NEWAPI_MODE 的生产闸同一条纪律）。

# ---------------------------------------------------------------------------
# 告警中心（XM-0033，规格 §9.3 / §9.4）
# ---------------------------------------------------------------------------
# 评估任务默认就跑（Foundation-A 的退出条件之一是「能触发一条真实告警」）。
# 关掉它是一个显式的停用动作（宪法 26 条），关掉之后告警页不会假装正常：
# 已有告警的「最近发现」停止前进，新问题不会被发现。
XM_ALERT_EVALUATE_ENABLED=true
# 评估周期。必须快于采集周期（XM_SUB2API_SYNC_INTERVAL，默认 300s）——
# 评估不产生新数据，它只是把最新一次采集的结论读出来。
XM_ALERT_EVALUATE_INTERVAL=60s

# --- 投递渠道 ---------------------------------------------------------------
# ⚠️ 下面三个渠道（Telegram / 自建 Webhook / 企业微信）的纪律与上面 Sub2API
#    那几项**相反**：配错（ref 拼错、URL 不是 https、Telegram 只配了一半）
#    会让 worker **拒绝启动**。
#    理由见 docs/modules/alerts/README.md：一个没建起来的告警渠道，
#    唯一的痕迹是启动时一行日志，之后每条告警都会静静地不投递，
#    而运维会以为自己配好了——等到真出事那天才发现没人被通知。
#
#    三个渠道全部留空是**允许**的：告警照常评估、照常落库、照常在告警页
#    显示，只是每轮打一条 warn「仅落库未投递」，投递状态停在「未投递」。
#    本地开发与刚起的环境就该是这个状态。

# Telegram：ref 与 chat_id 要么都配，要么都不配。
# ref 形如 secret://<scope>/<name>（ADR-014、宪法 7 条）。
#
# 这三个变量（本组 + 下面的 XM_ALERT_WEBHOOK_URL）同时也被 platform-api 读取
# （XM-OPS0，运行保障页「告警投递配置」只回布尔值）：platform-api 只判断
# 「配没配」，从不解析出明文，因此不需要、也没有读取 XM_ALERT_TELEGRAM_TOKEN。
XM_ALERT_TELEGRAM_BOT_REF=
XM_ALERT_TELEGRAM_CHAT_ID=
#
# 上面那个引用在 env Provider 下的落点：Bot Token 明文。
# ⚠️ 只填在不入库的 .env 里。
# ⚠️ 这个 Bot **只服务平台内部告警**。外部看门狗必须用另一个 Bot、
#    另一个收件会话——平台挂了的时候，经过平台的通知链也一起挂了
#    （规格 §9.4 红线、宪法 23 条，见 deploy/watchdog/README.md）。
XM_ALERT_TELEGRAM_TOKEN=
#
# 自建 Webhook 端点，必须 https（告警正文带环境名、指标键与余额数字）。
# ⚠️ Slack / 飞书这类地址本身就是凭据，同样只填在不入库的 .env 里。
XM_ALERT_WEBHOOK_URL=

# 企业微信群机器人（XM-ALERT-WECOM）。形如
# https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<uuid>——与上面两个
# 渠道不同，这里**整个地址就是凭据**（鉴权 key 直接嵌在查询参数里），因此
# 不接受静态配置值，只能经 CredentialRef 解析（PROJECT-CONSTITUTION 第 7 条）。
# ref 形如 secret://alerts/wecom-webhook。推荐路径是运营在后台「设置→凭据」
# 页直接粘贴地址（走文件优先的 SecretProvider 链，worker 不重启即生效）；
# 下面这个 env 落点仅在还没在后台填过时兜底，同样只填在不入库的 .env 里。
XM_ALERT_WECOM_WEBHOOK_REF=
XM_ALERT_WECOM_WEBHOOK=

# 渠道余额告警阈值，单位是**最小货币单位**的整数（宪法 13 条：金额禁止 float）。
# 500000 = 5000.00 CNY。写成小数会被 worker 当场拒绝——那说明写的人搞错了口径。
XM_ALERT_BALANCE_THRESHOLD_MINOR_UNITS=500000

# ---------------------------------------------------------------------------
# 对外暴露
# ---------------------------------------------------------------------------
# web 容器的发布地址。默认绑回环：管理后台不该因为一个默认值就开到公网。
# 服务器部署时改成 WEB_BIND=0.0.0.0（前面还应有一层带 TLS 的入口）。
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------------------------------------------------------------------------
# 前端鉴权（XM-AUTH1）
# ---------------------------------------------------------------------------
# web 容器启动时按这三项生成 /app-config.js（浏览器端读 window.__XM_CONFIG__）。
# 默认 dev-header：登录页是「开发模式进入」，请求带 X-Dev-* 头，与后端默认一致。
# 切 oidc 必须与上面「身份」一节的 XM_AUTH_MODE=oidc **同时**切，两边各认各的。
# issuer / client id 留空时回落到 XM_OIDC_ISSUER / XM_OIDC_AUDIENCE（本来就必须相同）。
# Keycloak Client 侧要先把 https://<host>/auth/callback 与 https://<host>/login
# 加进白名单，见 docs/modules/httpapi/AUTH-SWITCH.md「前端」一节。
# XM_WEB_AUTH_MODE=oidc
# XM_WEB_OIDC_ISSUER=https://auth.solov.cc/realms/solov-staff
# XM_WEB_OIDC_CLIENT_ID=xingmang-admin-web

# ---------------------------------------------------------------------------
# 开票控制台嵌入（CR-0005 平台线 i）
# ---------------------------------------------------------------------------
# Sub2API / NewAPI「支付与财务 → 开票」与治理「跨平台财务 → 开票集成」三处
# 用它当 iframe 的来源。静态直传，同 reqlog/CPA 先例——不是上面 oidc 那种
# 需要几个变量互相校验的模式开关，留空就是没接这个功能，三处页签显示
# 「未配置开票控制台来源」，不渲染 iframe，不会拿一个猜的地址垫上。
# 必须是不带路径/查询的 https 来源（前端 runtimeConfig.ts 会校验形状,
# 形状不对等同未配置）。生产地址见 docs/change-requests/CR-0005-invoice-admin-console.md。
# XM_INVOICE_CONSOLE_ORIGIN=https://invoice.solov.cc

# ---------------------------------------------------------------------------
# 构建标记（宪法 21 条：生产发布必须可追溯到 Task/PR/制品）
# ---------------------------------------------------------------------------
# 注入到二进制的 buildinfo，会出现在启动日志与 /healthz 响应里。
# 正式发布时由发布流程填真实值，例如：
#   BUILD_COMMIT=$(git rev-parse --short HEAD)
BUILD_VERSION=staging
BUILD_COMMIT=unknown

# ---------------------------------------------------------------------------
# 成本看板演示数据（XM-0037d）
# ---------------------------------------------------------------------------
#
# 置 true 时，platform-api 启动会经 L1 Action 种一批**演示**登记簿记录
# （两个计量型账号 + 一个订阅型账号，含一笔订阅批次与一份代理资产），
# 让 fake 模式下的成本三卡一上线就有内容。
#
# 三条纪律：
#   - **生产环境即便置 true 也会拒绝启动**。演示账号的地址是 .invalid
#     （保证解析不到），落进生产登记簿会让采集去打一批打不通的域名，
#     而台账里会多出几条永远算不出成本的渠道。
#   - **幂等**：环境里已经有任何一条登记簿记录就整个跳过，不与真实数据抢。
#   - **走 Action 内核**，参数校验、跨环境闸门、审计链一样都不少（宪法 2 条）。
#     审计里认它的方式是签发者 `xingmang://finance-demo-seed`。
#
# 默认留空（= false）。
XM_FINANCE_FAKE_SEED=

# ---------------------------------------------------------------------------
# 可用天数告警档（XM-0049）
# ---------------------------------------------------------------------------
#
# UI 交接 §10.4：「低于阈值时进入告警和待处理队列」。天数越少越严重——
# CRIT 必须严格小于 WARN，否则拒绝启动。
#
# 仅供一次性 tools-profile bootstrap 导入 DB；运行中的 API/worker 不读取这两个值。
# 旧值保留用于回滚旧镜像。非法值（非整数、非正、CRIT ≥ WARN）会让 bootstrap 失败。
#
# 第三档 serious（默认 20，最松的一档，只影响颜色）由 bootstrap 派生。
XM_FINANCE_RUNWAY_WARN_DAYS=
XM_FINANCE_RUNWAY_CRIT_DAYS=

# ---------------------------------------------------------------------------
# 请求详情 · reqlog file 模式（XM-REQLOG-MERGE）
# ---------------------------------------------------------------------------
# 数据源是记录代理 cmd/reqlog-recorder（宿主机 systemd 服务，站在宝塔
# nginx 与 NewAPI/Sub2API 之间做透明抄录）落盘的数据；platform-api 只读
# 挂载它的输出目录，不经 HTTP。切换步骤见
# docs/runbooks/REQLOG-RECORDER.md，字段口径见
# contracts/connectors/reqlog.read.v1.md。
#
# XM_REQLOG_MODE 三选一之外的第四个值：off（默认，不挂载端点）/ fake
# （演示数据，生产禁用）/ real（控制台 HTTP API，形状未核实，暂不可用）/
# file（本节，读记录代理落盘数据，唯一在生产可用的真实数据模式）。
# XM_REQLOG_MODE=file

# 下面两个是**容器内**路径，只在部署时用 server-prod.yaml 覆盖才会挂载
# 对应的宿主机目录；本文件对应的 staging 一键栈（launch.yaml）不挂载，
# 留空/默认值在 staging 下不指向真实数据。容器内默认值一般不需要改：
# XM_REQLOG_DATA_DIR=/var/lib/xm/reqlog
# XM_REQLOG_TOKENMAP=/var/lib/xm/reqlog-tokenmap.json
# XM_REQLOG_TOKENMAP_V2=/var/lib/xm/reqlog-tokenmap-v2.json

# 下面两个是**宿主机**路径，只在部署 server-prod.yaml 覆盖的机器上生效，
# 默认对应记录代理自己的默认落盘位置。目录/文件必须已经存在，否则 Docker
# 会把 XM_REQLOG_HOST_DATA_DIR 当成空目录创建——容器能起来，但请求列表
# 是空的，不是报错。
# XM_REQLOG_HOST_DATA_DIR=/root/reqlog/data
# XM_REQLOG_HOST_TOKENMAP=/root/reqlog/tokenmap.json
# CR-0008 的并行文件（上游用户 ID，解出 RequestLogSummary.User）。读侧把
# 文件缺失与"映射不到"当成同一件事，所以这条挂载缺席不会报错，只是 User
# 恒为 nil；反过来说，配错路径也不会报错，只会静悄悄地读不到。
# XM_REQLOG_HOST_TOKENMAP_V2=/root/reqlog/tokenmap.v2.json

# ---------------------------------------------------------------------------
# CPA 一致性快照 file 模式（XM-CPA-SNAPSHOT）
# ---------------------------------------------------------------------------
# production + file 时，deploy-local.sh 会从本次 migrate 镜像提取静态
# cpa-snapshot，先在宿主机完成 SQLite online backup/quick_check/原子发布，
# 再启动 API/worker；服务器不安装 Go/sqlite 开发工具。
XM_CPA_MODE=off
XM_CPA_DATA_DIR=/var/lib/xm/cpa
XM_CPA_FILE_NAME=usage.sqlite
XM_CPA_SYNC_ENABLED=
XM_CPA_SYNC_INTERVAL=300s
XM_CPA_INSTANCE_ID=cpa-cli-proxy-api

# 宿主路径是版本化部署契约，不从 .env 覆盖：
#   live source（仅宿主 lifecycle 工具）
#     /root/cpa-stack/cpam-data/usage.sqlite
#   published snapshot（API/worker 只读挂载）
#     /var/lib/xingmang/cpa-snapshot/published/usage.sqlite
# 平台容器绝不挂 live cpam-data、auths 或 config.yaml。

# ---------------------------------------------------------------------------
# Infini 卡服务（XM-CARD）
# ---------------------------------------------------------------------------
# off / fake / real。**默认 off**：这些 Action 会花真钱，不该在任何环境里
# 「顺便」开着。fake 用内存替身，不触及任何真实资金。
# --- 接码中心（XM-SMS0）--------------------------------------------------
# off / fake / real。**这是接码唯一的环境变量。**
#
# 「开哪几家供应商」不在这里：那是运营随时会改的决定（换供应商、某家挂了先
# 停掉），落进配置文件意味着每次改都要登服务器改文件再重启，而重启期间整个
# 平台不可用。开关在管理后台「接码中心」每张供应商卡上点，走
# Action sms.provider.set_enabled@1，审计里留下「谁在什么时候把这家关了」。
#
# 留在环境变量里的理由只有一个：它决定这个进程会不会花真钱。做成后台可改，
# 一次误操作就能让开发环境开始买真号，或者让生产悄悄切到替身而页面一切正常。
#
# 两条 API 密钥也不在这里，在管理后台「密钥引用」页填：
#   secret://sms62/api-key、secret://hero-sms/api-key
#   （hero 是**连字符**：ref 的 scope 规则不收下划线）
# 可选：secret://sms/notify-webhook 填企业微信群机器人地址，收到的验证码会
#   推过去；不填就不推，不影响取码。**群成员都能看到码。**
#
# 上线顺序：配这个变量 → 填密钥 → 逐家「连接测试」→ 通过后点「启用」。
# 新装环境两家默认都是关的。
XM_SMS_MODE=off
# 巡检节奏（XM-SMS2 #7）：platform-worker 每隔这么久给每家做一次只读的连接
# 测试，并给有余额接口的那家抓一次余额快照（阶段 3 用它与成本事件对账）。
# **一分钱都不花。** 留空 = 10 分钟；开关跟着 XM_SMS_MODE 走，没有独立的
# ENABLED——off 时这个任务根本不注册。
# XM_SMS_PROBE_INTERVAL=10m

XM_CARDS_MODE=off
# base URL 必须是 https（请求带签名），其主机名就是写通道 allowlist 的
# 唯一成员——写通道不接受通配。所有账号共用同一个端点。
# XM_CARDS_BASE_URL=https://openapi.infini.money
#
# 账号清单（逗号分隔）。**必须显式声明，没有单账号的隐式回落**：
# 一个「只配了一对凭据就默默当成唯一账号」的行为，会在加第二个账号时把钱
# 花到错的地方。账号 id 只接受大写字母/数字/下划线——它要拼进下面的变量名。
#
# 当前两个账号：CHRIS（chris / soulmatevip.x@gmail.com）与
# LINFENG（LINFENG AURORA INC / xufei5620136@gmail.com）。
#
# ⚠️ 改账号 id 时，deploy/compose/launch.yaml 里枚举的那几行也要跟着改
#    （compose 无法动态枚举变量名）。
# XM_CARDS_ACCOUNTS=CHRIS,LINFENG
#
# 每个账号只配金额上限。**凭据不在这里配**：引用由账号 id 推出
# （secret://infini-<账号id小写>/api-key-id 与 /api-secret），值由运营在
# 管理端「人员与权限 → 密钥引用」页填写与轮换——那一页写进去的就是
# SecretProvider 读的文件，不用登服务器手写。
#
# 金额上限单位是所选代币本身，**不做汇率换算**；未配齐时领域层 fail closed，
# 开卡一律被拒——空配置不等于「随便花」。
# 金额上限：每个账号两档，单位是申请金额本身的币种（USDT/USDC），不做汇率换算。
# 只作用于「花钱」的两个动作——开卡时的初始充值额、给已有卡充值；
# 赎回/冻结/解冻不受它管（用上限卡住止损动作没有道理）。
# 单日档是按 账号 × 操作类型 × 当天 累计的，且把 unknown 状态的操作算在内。
#
# 填 unlimited 表示这一档显式不设限。**留空不等于不设限**：留空是「没配」，
# 开卡会被直接拒——忘了配和故意不限必须是两件事，否则哪天配置掉了，
# 护栏会安静地消失而没人发现。
#
# 当前口径（内部自用，产品负责人 2026-09-04 拍板）：不设限。理由是 Infini
# 账户余额本身就是硬顶，且充值可以 redeem 拉回来。以后要加护栏，最值钱的是
# 单笔档——它当的是手滑挡板（把 100.00 打成 10000 时当场拒掉，
# 而不是等你事后发现再去赎回）。
XM_CARDS_CHRIS_LIMIT_PER_OPERATION=unlimited
XM_CARDS_CHRIS_LIMIT_PER_DAY=unlimited
XM_CARDS_LINFENG_LIMIT_PER_OPERATION=unlimited
XM_CARDS_LINFENG_LIMIT_PER_DAY=unlimited

# 提现额度**不配在这里**（XM-CARD6）。
#
# 它存在数据库里，由管理端「卡片管理 → 提现 → 改额度」调整。原先是环境
# 变量，产品负责人 2026-09-05 要求改掉：一个要登服务器改文件再重启才能动的
# 数字，实际上没人会去动——它会永远停在第一次拍脑袋定的那个值上。
#
# 没设过额度的账号**不能提现**（fail closed）。这是新装环境的默认状态。
# 额度不接受「不限」：把余额搬空正是提现的目的，余额不构成上限。
#
# 改额度要 fund.limit.manage 权限（admin 持有），发起提现要 fund.withdraw
# （fund-operator 持有）——两把钥匙分持，拿到任一把都搬不空资金池。

# 按账号覆盖端点（XM-CARD4）。留空沿用上面的 XM_CARDS_BASE_URL。
# 存在的唯一理由是沙箱：沙箱端点是 https://openapi-sandbox.infini.money，
# 与生产不同，而沙箱账号要与生产账号并存才能在同一套部署里联调回调
# （回调要公网可达，本地跑不了）。
# 指向 sandbox 的账号会在管理端被显著标记——一张沙箱假卡和真卡在列表里
# 长得一模一样，不标记比没有沙箱更危险。
# XM_CARDS_SANDBOX_BASE_URL=https://openapi-sandbox.infini.money
#
# 回调验签密钥不在这里配：它和 API 密钥一样走管理端「密钥引用」页，
# 引用是 secret://infini-<账号小写>/webhook-secret。
# 回调地址填 https://<管理后台域名>/webhooks/infini/<账号 id>。
#
# worker 侧的两个可选项：不确定态宽限期（留空 30 分钟）、是否同步流水。
#
# 流水同步自 XM-CARD6 起**默认开启**（留空即开）。原先默认关闭的理由是
# 「调用量与卡数成正比，而上游限流阈值未知」，那个未知已在 2026-09-05
# 实测掉：600 次/分钟/密钥，250 张卡 5 分钟一轮只占 8%。
# 只有显式的 false 才关闭——拼错的值按开启处理，因为少同步的代价是流水
# 长期缺失而没有任何报错。
# XM_CARDS_UNKNOWN_GRACE=30m
# XM_CARDS_SYNC_TRANSACTIONS=false
