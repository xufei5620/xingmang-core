# deploy/compose/launch.yaml 的环境变量样例（XM-0023）。
#
# 用法：
#   cp deploy/compose/.env.example deploy/compose/.env
#   然后把 DATABASE_PASSWORD 换成真实值。
#
# ⚠️ 真实的 .env **不入库**：根 .gitignore 里的 `.env` / `.env.*` 已经挡住，
#    `!*.example` 才让本文件通过。提交前用 `git status` 确认 .env 没被列出来。
#    仓库里出现明文凭据 = 宪法 7 条事故，撤销比防住贵得多。

# ---------------------------------------------------------------------------
# 环境
# ---------------------------------------------------------------------------
# development / staging / production 三选一。
# ⚠️ 改成 production 会让 platform-api **拒绝启动**，除非同时把身份切到 OIDC
#    （见下面「身份」一节）：Foundation-A 的身份来自 X-Dev-* 请求头，允许调用方
#    自称身份等于没有鉴权。上生产的前置条件是 CR-0001（Keycloak/OIDC）。
ENVIRONMENT=staging

# ---------------------------------------------------------------------------
# 身份（XM-0008）
# ---------------------------------------------------------------------------
# XM_AUTH_MODE ∈ dev-header | oidc。默认跟着 ENVIRONMENT 走：
#   production → oidc（且只能是 oidc）；development / staging → dev-header。
#
# ⚠️ 下面三行**刻意注释掉**：CR-0001 还没执行，没有 solov-staff Realm 可连。
#    打开它们之前请先读 docs/modules/httpapi/AUTH-SWITCH.md，特别是
#    「RoleScopeMap 必须人工审定」那一节——它决定登录进来的员工默认能看到什么。
#
# XM_AUTH_MODE=oidc
# XM_OIDC_ISSUER=https://auth.solov.cc/realms/solov-staff
# XM_OIDC_AUDIENCE=xingmang-admin-web
#
# 可选：
# XM_OIDC_ROLE_SCOPES={"staff":["registry.read","ops.read"]}   # 留空用代码默认表
# XM_OIDC_JWKS_URL=...   # 留空从 issuer 的 /.well-known 发现；必须与 issuer 同源
# XM_OIDC_CLOCK_SKEW=60s # 时钟偏移容忍，上限 5m

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
POSTGRES_DB=xingmang
POSTGRES_USER=xingmang

# 数据库密码。**必填**，没有默认值——compose 会直接报错退出，
# 而不是用一个「大家都知道」的弱口令把栈跑起来。
# 生成一个：openssl rand -base64 32
# 这个值同时用于：postgres 容器的初始化（走 Docker secret 文件）、
# 以及三个 Go 服务的 CredentialRef 解析（DATABASE_PASSWORD_REF → 本变量）。
DATABASE_PASSWORD=

# 密码的 CredentialRef（ADR-014）。格式 secret://<scope>/<name>。
# 服务不直接读固定环境变量名，而是解析这个 ref——将来换成 SOPS/Vault
# Provider 时，只有 Provider 的装配处要改，业务代码一行不动。
DATABASE_PASSWORD_REF=secret://database/postgres-password

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
# platform-api 单请求期限
REQUEST_TIMEOUT=30s

# worker 心跳间隔（River 要求 >= 1s）
HEARTBEAT_INTERVAL=1m

# Sub2API 连接器模式：fake / real（变量由 XM-0022 实现）。
# fake 的数据是**演示与联调**用的，不是业务真相——前端展示时必须能区分。
# 切 real 的完整步骤见 docs/modules/connector/RUNBOOK.md，下面四个变量是它的入参。
XM_SUB2API_MODE=fake

# --- 切真实数据用（XM_SUB2API_MODE=real 时四项缺一不可）-----------------------
# 四项没配齐时 worker **照常启动**，只是每轮同步往看板写一条
# not_supported 的失败观测，并在日志里说清缺哪个变量——一个没配好的采集
# 通道不该把心跳和别的任务一起拖垮。
#
# 上游只读端点，必须 https（http 会被连接配置直接拒绝）。
XM_SUB2API_ENDPOINT=
#
# 允许连接的主机**精确**清单，逗号分隔，不做后缀匹配、不做通配。
# 留空不是「放行一切」而是「一个请求都发不出去」（fail closed，ADR-004）。
# endpoint 的主机必须自己也在这份清单里，否则配置自相矛盾、一个请求都发不出。
# 例：XM_SUB2API_TARGET_ALLOWLIST=api.solov.cc
XM_SUB2API_TARGET_ALLOWLIST=
#
# 只读凭据的引用，形如 secret://<scope>/<name>（ADR-014、宪法 7 条）。
# 服务不直接读固定变量名，而是解析这个引用；将来换 SOPS/Vault 时
# 只有 cmd/platform-worker 里的登记表要改，Connector 一行不动。
# 例：XM_SUB2API_CREDENTIAL_REF=secret://sub2api/readonly-token
XM_SUB2API_CREDENTIAL_REF=
#
# 上面那个引用在 env Provider 下的落点：**只读**账号的 API Token 明文。
# ⚠️ 只填在不入库的 .env 里；轮换时改这里 + 上游吊销旧 token，不用改代码。
# ⚠️ 这个账号必须是只读的：平台侧只做了「不发写请求」的强制，
#    做不到「上游拒绝写请求」——后者只有发一个真正的只读账号才做得到。
XM_SUB2API_TOKEN=

# ---------------------------------------------------------------------------
# 告警中心（XM-0033，规格 §9.3 / §9.4）
# ---------------------------------------------------------------------------
# 评估任务默认就跑（Foundation-A 的退出条件之一是「能触发一条真实告警」）。
# 关掉它是一个显式的停用动作（宪法 26 条），关掉之后告警页不会假装正常：
# 已有告警的「最近发现」停止前进，新问题不会被发现。
XM_ALERT_EVALUATE_ENABLED=true
# 评估周期。必须快于采集周期（XM_SUB2API_SYNC_INTERVAL，默认 300s）——
# 评估不产生新数据，它只是把最新一次采集的结论读出来。
XM_ALERT_EVALUATE_INTERVAL=60s

# --- 投递渠道 ---------------------------------------------------------------
# ⚠️ 这三组的纪律与上面 Sub2API 那几项**相反**：配错（ref 拼错、URL 不是
#    https、Telegram 只配了一半）会让 worker **拒绝启动**。
#    理由见 docs/modules/alerts/README.md：一个没建起来的告警渠道，
#    唯一的痕迹是启动时一行日志，之后每条告警都会静静地不投递，
#    而运维会以为自己配好了——等到真出事那天才发现没人被通知。
#
#    三个都留空是**允许**的：告警照常评估、照常落库、照常在告警页显示，
#    只是每轮打一条 warn「仅落库未投递」，投递状态停在「未投递」。
#    本地开发与刚起的环境就该是这个状态。

# Telegram：ref 与 chat_id 要么都配，要么都不配。
# ref 形如 secret://<scope>/<name>（ADR-014、宪法 7 条）。
XM_ALERT_TELEGRAM_BOT_REF=
XM_ALERT_TELEGRAM_CHAT_ID=
#
# 上面那个引用在 env Provider 下的落点：Bot Token 明文。
# ⚠️ 只填在不入库的 .env 里。
# ⚠️ 这个 Bot **只服务平台内部告警**。外部看门狗必须用另一个 Bot、
#    另一个收件会话——平台挂了的时候，经过平台的通知链也一起挂了
#    （规格 §9.4 红线、宪法 23 条，见 deploy/watchdog/README.md）。
XM_ALERT_TELEGRAM_TOKEN=
#
# 自建 Webhook 端点，必须 https（告警正文带环境名、指标键与余额数字）。
# ⚠️ Slack / 飞书这类地址本身就是凭据，同样只填在不入库的 .env 里。
XM_ALERT_WEBHOOK_URL=

# 渠道余额告警阈值，单位是**最小货币单位**的整数（宪法 13 条：金额禁止 float）。
# 500000 = 5000.00 CNY。写成小数会被 worker 当场拒绝——那说明写的人搞错了口径。
XM_ALERT_BALANCE_THRESHOLD_MINOR_UNITS=500000

# ---------------------------------------------------------------------------
# 对外暴露
# ---------------------------------------------------------------------------
# web 容器的发布地址。默认绑回环：管理后台不该因为一个默认值就开到公网。
# 服务器部署时改成 WEB_BIND=0.0.0.0（前面还应有一层带 TLS 的入口）。
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------------------------------------------------------------------------
# 构建标记（宪法 21 条：生产发布必须可追溯到 Task/PR/制品）
# ---------------------------------------------------------------------------
# 注入到二进制的 buildinfo，会出现在启动日志与 /healthz 响应里。
# 正式发布时由发布流程填真实值，例如：
#   BUILD_COMMIT=$(git rev-parse --short HEAD)
BUILD_VERSION=staging
BUILD_COMMIT=unknown
