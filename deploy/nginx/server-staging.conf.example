# 服务器 staging 外层入口示例（仓库只保存模板，不保存证书或 htpasswd）。
#
# 使用前：
#   1. 把 server_name、证书路径、Basic Auth 文件路径换成服务器上的值；
#   2. 将 .htpasswd、私钥设为 root:root 0600，并放在仓库之外；
#   3. 确认 deploy.sh staging 使用的 STAGING_WEB_PORT 与这里一致。
#
# platform-web 只绑定 127.0.0.1:18088；外部流量只能从这层进入。

server {
    listen 80;
    server_name staging.example.invalid;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name staging.example.invalid;
    server_tokens off;

    ssl_certificate     /etc/ssl/xingmang/staging/fullchain.pem;
    ssl_certificate_key /etc/ssl/xingmang/staging/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    auth_basic           "Xingmang staging";
    auth_basic_user_file /etc/nginx/xingmang/staging.htpasswd;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization     $http_authorization;
    proxy_read_timeout 60s;

    # 探针不需要 Basic Auth；如需公网可见，应在此处再加 allow/deny。
    location = /healthz {
        auth_basic off;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:18088/healthz;
    }
    location = /readyz {
        auth_basic off;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:18088/readyz;
    }

    location / {
        proxy_pass http://127.0.0.1:18088;
    }
}
