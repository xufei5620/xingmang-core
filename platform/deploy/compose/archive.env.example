# Operator-managed fixture inputs for deploy/compose/archive.yaml.
# Copy this file outside the repository (for example, to an ignored secrets
# directory) and provide its path as XM_ARCHIVE_CREDENTIAL_ENV_FILE.
# Values are intentionally blank; resolve them through the listed CredentialRefs.

# MinIO object-writer access is supplied to platform-worker separately via
# secret://archive/minio-runtime; it is not copied into this fixture env file.

# secret://archive/minio-qualification (one-time disposable fixture access)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# secret://archive/minio-kms (MinIO SSE-S3 key material)
MINIO_KMS_SECRET_KEY=
