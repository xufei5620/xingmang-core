{
  "realm": "solov-staff",
  "displayName": "星芒员工",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "staff", "description": "员工身份标记(平台细粒度权限不在此)" },
      { "name": "admin", "description": "平台管理员(粗粒度;细粒度 scope 由平台 RoleScopeMap 决定)" },
      { "name": "credential-admin", "description": "可在管理后台录入/轮换凭据与切换接入模式" },
      { "name": "auditor", "description": "审计只读" },
      { "name": "key-metadata-reader", "description": "API Key 元数据只读" }
    ]
  },
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true, "priority": 10 },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30 }
  ],
  "clients": [
    {
      "clientId": "xingmang-admin-web",
      "name": "星芒统一控制平台 管理端",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://console.solov.cc/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://console.solov.cc",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://console.solov.cc/*##http://localhost:5173/*",
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "audience-xingmang-admin-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "xingmang-admin-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
