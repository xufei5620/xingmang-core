{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xingmang.local/contracts/cpa/plugin-store-sources.v1",
  "title": "CPA Plugin Store Sources v1",
  "description": "Pinned source metadata for offline assessment. This contract authorizes no network fetch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": {"const": 1},
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "registry_url", "registry_sha256", "registry_signature", "repository_allowlist", "auth_method", "credential_ref", "redirect_host_allowlist", "artifact_host_allowlist", "max_registry_bytes", "max_artifact_bytes", "tls_policy", "proxy_policy", "owner"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "name": {"type": "string", "minLength": 1},
          "registry_url": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$"},
          "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "registry_signature": {"type": "string", "minLength": 1},
          "repository_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^?#*]+$"}},
          "plugin_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
          "auth_method": {"const": "credential_ref"},
          "credential_ref": {"type": "string", "pattern": "^(cred|secret|env)://[^\\s]+$"},
          "redirect_host_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}},
          "artifact_host_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}},
          "max_registry_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "max_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
          "tls_policy": {"const": "required"},
          "proxy_policy": {"enum": ["disabled", "explicit"]},
          "owner": {"type": "string", "minLength": 1},
          "allow_fallback": {"const": false},
          "description": {"type": "string"},
          "readme": {"type": "string"}
        }
      }
    }
  }
}
